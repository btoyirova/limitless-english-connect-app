# ==============================================================================
# Limitless English Connect - Production Environment Configuration
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI real-time speaking evaluation.
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: Public URL where your app is hosted (e.g., https://limitless-english.onrender.com or your custom domain)
APP_URL="https://your-domain.com"

# SUPABASE: PostgreSQL Database & Authentication (Client & Server)
# Obtain from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
